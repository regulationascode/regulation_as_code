{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Human interpretation record",
  "type": "object",
  "required": ["schema_version", "regulation_id", "status", "source_refs", "decision_points", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "regulation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "legal-reviewed", "institution-specific"] },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "requires_human_decision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "requires_human_decision": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "review": {
      "type": "object",
      "required": ["reviewer_role", "reviewed_on"],
      "properties": {
        "reviewer_role": { "type": "string", "minLength": 1 },
        "reviewed_on": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "legal-reviewed" } } },
      "then": { "required": ["review"] }
    }
  ]
}
