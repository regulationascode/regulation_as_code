{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regulation source manifest",
  "type": "object",
  "required": ["schema_version", "regulation_id", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "regulation_id": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "publisher", "title", "url", "format", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "role": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "format": { "enum": ["XML", "JSON", "HTML", "PDF", "other"] },
          "status": { "type": "string", "minLength": 1 },
          "retrieved_at": { "type": ["string", "null"] },
          "as_of_date": { "type": ["string", "null"] },
          "effective_date": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "source-captured" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "retrieved_at": { "type": "string", "minLength": 1 },
          "as_of_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    }
  ]
}
