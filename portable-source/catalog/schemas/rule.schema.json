{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rule implementation record",
  "type": "object",
  "required": ["schema_version", "regulation_id", "rule_id", "status", "source_refs", "implementation", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "regulation_id": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "enum": ["prototype-only", "proposed", "approved"] },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "implementation": {
      "type": "object",
      "required": ["executable", "scope", "code_reference"],
      "properties": {
        "executable": { "type": "boolean" },
        "scope": { "type": "string", "minLength": 1 },
        "code_reference": { "type": ["string", "null"] },
        "calendar": { "type": "string" },
        "output_type": { "type": "string" }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "approval": {
      "type": "object",
      "required": ["reviewer_role", "reviewed_on", "source_version"],
      "properties": {
        "reviewer_role": { "type": "string", "minLength": 1 },
        "reviewed_on": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "required": ["approval"],
        "properties": { "implementation": { "properties": { "executable": { "const": true } } } }
      }
    }
  ]
}
