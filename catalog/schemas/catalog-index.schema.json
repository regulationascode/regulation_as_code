{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regulation catalog index",
  "type": "object",
  "required": ["catalog_schema_version", "catalog_id", "catalog_status", "entries"],
  "properties": {
    "catalog_schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 1 },
    "catalog_status": { "enum": ["prototype", "pilot", "maintained"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "citation", "title", "package_path", "lifecycle"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "citation": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "package_path": { "type": "string", "pattern": "^[a-z0-9/-]+$" },
          "lifecycle": {
            "type": "object",
            "required": ["source", "interpretation", "implementation", "tests"],
            "properties": {
              "source": { "type": "string" },
              "interpretation": { "type": "string" },
              "implementation": { "type": "string" },
              "tests": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
