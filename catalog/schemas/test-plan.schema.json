{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Regulation test plan",
  "type": "object",
  "required": ["schema_version", "regulation_id", "status", "test_reference", "required_case_types", "does_not_prove"],
  "properties": {
    "schema_version": { "const": 1 },
    "regulation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["synthetic-only", "institution-tested", "not-tested"] },
    "test_reference": { "type": "string", "minLength": 1 },
    "required_case_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "does_not_prove": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
